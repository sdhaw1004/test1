#13) 행단위 작업
#rowwise()는 행단위 그룹 지정, group_by는 열단위 그룹 지정
df1 = tibble(x=1:2, y=3:4, z=5:6)
df1 %>% 
  mutate(total = sum(x,y,z)) #1+2+3+4+5+6
df1 %>%
  rowwise() %>% 
  mutate(total = sum(c_across(x:z))) #행별로 더함 --> across는 범위로 지정하여야함

df2 = 
  tibble(id = 1:3, w = 10:12, x=20:22, y=30:32)
df2
df2 %>% 
  rowwise(id) %>% 
  mutate(total = sum(c_across(where(is.numeric))))

scores=tibble(국=c(90, 80), 영=c(70,90), 수=c(100,60))
scores
scores %>%
  rowwise() %>% 
  mutate(total = sum(c_across(국:수))) %>% 
  mutate(평균 = mean(c_across(국:수)))
# 범위를 지정하기 위해서 c_across를 사용




