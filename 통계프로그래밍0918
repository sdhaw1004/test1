library(tidyverse)


ggplot(data = mpg, mapping = aes(x=displ, y=hwy, color = cyl)) +  #--> ggplot과 geom함수 연결 함수
 geom_point() 
# 산점도는 세가지 변수 관계 파악 유리
# geom끼리 +로 추가하면 그래프가 두개가 나타나는 것이 아닌 겹쳐서 나타남
#aes는 중첩 가능


ggplot(data = mpg, mapping = aes(x=displ, y=hwy, shape = drv)) +
  geom_point()
ggplot(data = mpg, mapping = aes(x=displ, y=hwy, size = cyl)) +
  geom_point()
ggplot(data = mpg, mapping = aes(x=displ, y=hwy, shape = drv, size = cyl)) +
  geom_point()
#shape는 범주형 변수만 가능
#size는 범주형에 사용 불가: 범주형은 순서통계가 아니기 때문에 자료 왜곡의 여지가 있음

ggplot(mpg, aes(displ, hwy)) +
  geom_point(shape = 21, size = 2, , color="blue", fill = "red", stroke = 1)
#stroke는 테두리 두께 설정
