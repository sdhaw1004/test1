    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "OetoLV8r2tLd"
      },
      "outputs": [],
      "source": [
        "batch = train_images[128:256]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ZCOC1VWL2tLd"
      },
      "outputs": [],
      "source": [
        "n = 3\n",
        "batch = train_images[128 * n : 128 * (n + 1)]"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "KVFEL6Fa2tLd"
      },
      "source": [
