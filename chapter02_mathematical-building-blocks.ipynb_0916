      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "aYA8eZqb2tLa"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "x = np.array(12)\n",
        "x"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "HzrSDKFE2tLa"
      },
      "outputs": [],
